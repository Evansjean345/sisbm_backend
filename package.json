{
  "name": "sisbm_core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SISBM CORE - Plateforme de tracking GPS et de supervision de flotte",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#domain/*": "./app/domain/*.js",
    "#application/*": "./app/application/*.js",
    "#infrastructure/*": "./app/infrastructure/*.js",
    "#presentation/*": "./app/presentation/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#tests/*": "./tests/*.js"
  },
  "scripts": {
    "dev": "node ace serve --hmr",
    "build": "node ace build",
    "start": "node bin/server.js",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node ace migration:run",
    "db:rollback": "node ace migration:rollback",
    "db:seed": "node ace db:seed",
    "db:fresh": "node ace migration:fresh --seed",
    "db:sql": "node ace sisbm:apply-sql",
    "check": "npm run arch && npm run lint && npm run typecheck && npm run test",
    "arch": "bash scripts/check-architecture.sh"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.5",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/transmit": "^3.0.1",
    "@vinejs/vine": "^4.4.0",
    "bullmq": "^6.0.7",
    "luxon": "^3.7.2",
    "mqtt": "^5.15.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@swc/core": "^1.15.47",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "hotHook": {
    "boundaries": [
      "./app/presentation/**/*.ts",
      "./app/application/**/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}

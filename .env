# =============================================================================
#  SISBM CORE — variables d'environnement
#  NE JAMAIS COMMITER CE FICHIER
# =============================================================================
#
#  PORTS — plage réservée à SISBM
#  Ta machine héberge déjà un PostgreSQL natif Windows (postgres.exe, service
#  permanent) sur 5432, plus la pile « aiglesend » sur 3307/5433/5434/6377/6378
#  et 3333. Tous les ports ci-dessous sont choisis hors de ces plages.
#
#      PostgreSQL   5435      (natif Windows : 5432 · aiglesend : 5433, 5434)
#      Redis        6380      (aiglesend : 6377, 6378)
#      MQTT         1883      (libre)
#      API          3336      (aiglesend-dev-api : 3333)
#
# =============================================================================

TZ=UTC
PORT=3336
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=VG3ADychEdxlKlVxUcPnG-JbtwePSPO_
NODE_ENV=development

# --------------------------------------------------------------- base de données
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=sisbm_core
# Migrations : sisbm_owner  |  Runtime applicatif : sisbm_app
DB_USER=sisbm_owner
DB_PASSWORD=sisbm_dev_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# --------------------------------------------------------------- redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# --------------------------------------------------------------- flespi
FLESPI_TOKEN=GW2QQgSqEJn4gpJbmEisBoSeUhKp42Leh6ykldMNVk8fY8NvyCdsp4FEW0IhJ70o
FLESPI_MQTT_HOST=mqtt.flespi.io
FLESPI_MQTT_PORT=8883
FLESPI_MQTT_TLS=true
FLESPI_MQTT_CLIENT_ID=sisbm-core-dev
FLESPI_WEBHOOK_SECRET=

# --------------------------------------------------------------- flespi
# ⚠ Le jeton précédent a été divulgué : le RÉVOQUER sur flespi.io et en
# générer un nouveau avant toute utilisation.
FLESPI_BASE_URL=https://flespi.io
FLESPI_TIMEOUT_MS=10000
FLESPI_CHANNEL_ID=0
FLESPI_DEVICE_TYPE_ID=Micodus MV730

# --------------------------------------------------------------- ingestion
# Filtres qualité appliqués à chaque position (cf. gouvernance §e)
INGEST_MAX_HDOP=5
INGEST_MIN_SATELLITES=4
INGEST_MAX_PLAUSIBLE_SPEED_KPH=250
# Au-delà de ce décalage recorded_at/received_at, la trame est traitée
# en rattrapage Store & Forward et exclue du flux temps réel.
INGEST_BACKLOG_THRESHOLD_SECONDS=300

# --------------------------------------------------------------- trajets
TRIP_IDLE_TIMEOUT_SECONDS=300
TRIP_MAX_DURATION_HOURS=24
TRIP_MIN_DISTANCE_M=100


# --------------------------------------------------------------- broker mqtt
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=false      # true en production
MQTT_PROTOCOL_VERSION=5 
MQTT_CLIENT_ID=sisbm-ingest
MQTT_USERNAME=sisbm_ingest
MQTT_PASSWORD=Ing3st_S1sbm#2026
MQTT_MONITOR_PASSWORD=M0n1t_S1sbm#2026
MQTT_TOPIC_TELEMETRY=sisbm/telemetry/+/data
MQTT_TOPIC_EVENTS=sisbm/telemetry/+/events
MQTT_MESSAGE_EXPIRY_SECONDS=300 # TTL : au-delà, la position est périmée
MQTT_RECONNECT_PERIOD_MS=2000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_MAX_INFLIGHT=1000
MQTT_QOS=1                       # « au moins une fois » — le dédoublonnage


# --------------------------------------------------------------- sécurité / immobilisation
# CM-07 : aucune coupure moteur au-dessus de ce seuil
IMMOBILIZATION_SAFETY_SPEED_KPH=5
IMMOBILIZATION_REQUIRE_VALIDATION=true
IMMOBILIZATION_COMMAND_TTL_MINUTES=15
IMMOBILIZATION_ENABLED=false
IMMOBILIZATION_MAX_POSITION_AGE_SECONDS=120

# --------------------------------------------------------------- notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@sisbm.ci

SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SISBM

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --------------------------------------------------------------- rétention
RETENTION_POSITIONS_MONTHS=24
RETENTION_INGEST_MESSAGES_MONTHS=1
RETENTION_REPORTS_DAYS=7
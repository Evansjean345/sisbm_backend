# =============================================================================
#  SISBM CORE — variables d'environnement
#  Copier en .env — NE JAMAIS COMMITER le .env réel
# =============================================================================

TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# --------------------------------------------------------------- base de données
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sisbm_core
# Migrations : sisbm_owner  |  Runtime applicatif : sisbm_app
DB_USER=sisbm_owner
DB_PASSWORD=sisbm_dev_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# --------------------------------------------------------------- redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------- flespi
FLESPI_TOKEN=
FLESPI_MQTT_HOST=mqtt.flespi.io
FLESPI_MQTT_PORT=8883
FLESPI_MQTT_TLS=true
FLESPI_MQTT_CLIENT_ID=sisbm-core-dev
FLESPI_WEBHOOK_SECRET=

# --------------------------------------------------------------- ingestion
# Filtres qualité appliqués à chaque position (cf. gouvernance §e)
INGEST_MAX_HDOP=5
INGEST_MIN_SATELLITES=4
INGEST_MAX_PLAUSIBLE_SPEED_KPH=250
# Au-delà de ce décalage recorded_at/received_at, la trame est traitée
# en rattrapage Store & Forward et exclue du flux temps réel.
INGEST_BACKLOG_THRESHOLD_SECONDS=300

# --------------------------------------------------------------- trajets
TRIP_IDLE_TIMEOUT_SECONDS=300
TRIP_MAX_DURATION_HOURS=24
TRIP_MIN_DISTANCE_M=100

# --------------------------------------------------------------- sécurité / immobilisation
# CM-07 : aucune coupure moteur au-dessus de ce seuil
IMMOBILIZATION_SAFETY_SPEED_KPH=5
IMMOBILIZATION_REQUIRE_VALIDATION=true
IMMOBILIZATION_COMMAND_TTL_MINUTES=15
IMMOBILIZATION_ENABLED=false

# --------------------------------------------------------------- notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@sisbm.ci

SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SISBM

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --------------------------------------------------------------- rétention
RETENTION_POSITIONS_MONTHS=24
RETENTION_INGEST_MESSAGES_MONTHS=1
RETENTION_REPORTS_DAYS=7